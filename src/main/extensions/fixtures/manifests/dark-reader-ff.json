{
  "manifest_version": 2,
  "name": "Dark Reader",
  "short_name": "Dark Reader",
  "description": "Dark mode for every website. Take care of your eyes, use dark theme for night and daily browsing.",
  "version": "4.9.80",
  "author": "Dark Reader Ltd",
  "browser_specific_settings": { "gecko": { "id": "addon@darkreader.org", "strict_min_version": "58.0" } },
  "icons": { "16": "ui/assets/images/darkreader-icon-16.png", "48": "ui/assets/images/darkreader-icon-48.png", "128": "ui/assets/images/darkreader-icon-128.png" },
  "permissions": ["alarms", "fontSettings", "storage", "tabs", "theme", "<all_urls>"],
  "commands": {
    "toggle": { "suggested_key": { "default": "Alt+Shift+D" }, "description": "Toggle current site" },
    "addSite": { "suggested_key": { "default": "Alt+Shift+A" }, "description": "Toggle current site" },
    "switchEngine": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Switch engine" }
  },
  "background": { "scripts": ["background/index.js"] },
  "browser_action": {
    "default_icon": { "19": "ui/assets/images/darkreader-icon-19.png", "38": "ui/assets/images/darkreader-icon-38.png" },
    "default_title": "Dark Reader",
    "default_popup": "ui/popup/index.html"
  },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["inject/fallback.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true },
    { "matches": ["<all_urls>"], "js": ["inject/index.js"], "run_at": "document_start", "all_frames": true, "match_about_blank": true }
  ],
  "options_ui": { "page": "ui/stylesheet-editor/index.html", "open_in_tab": true },
  "web_accessible_resources": []
}
