{
  "manifest_version": 3,
  "name": "Return YouTube Dislike",
  "version": "3.0.0.19",
  "browser_specific_settings": { "gecko": { "id": "{762f9885-5a13-4abd-9c77-433dcd38b8fd}" } },
  "permissions": ["activeTab", "storage", "menus", "https://*.youtube.com/*", "webRequestBlocking", "tabHide"],
  "optional_permissions": ["https://returnyoutubedislikeapi.com/*"],
  "content_security_policy": "script-src 'self'; object-src 'self'",
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_popup": "popup.html" },
  "commands": { "_execute_browser_action": { "suggested_key": { "default": "Alt+Shift+R" } } },
  "content_scripts": [{ "matches": ["https://*.youtube.com/*"], "js": ["ryd.content-script.js"], "run_at": "document_start" }],
  "web_accessible_resources": ["/ryd.script.js", "icons/icon48.png"]
}
