{
  "manifest_version": 3,
  "name": "Lyra fixture minimale",
  "version": "1.0.0",
  "description": "Extension de test : pose un marqueur sur la page.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "contenu.js"
      ],
      "run_at": "document_start"
    }
  ]
}
